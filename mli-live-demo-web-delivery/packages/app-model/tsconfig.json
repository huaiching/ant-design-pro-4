{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    //不排放；允許 Babel 轉換檔。
    "noEmit": false,
    // 不允許需要跨文件資訊才能發出的功能。
    "isolatedModules": true,
    // 將非 ES 模組作為預設導入。
    "esModuleInterop": true,
    // jsx 處理程序
    "jsx": "preserve",
    "declaration": true,
    "rootDir": "./src"
  },
  "include": ["./src"],
  "exclude": ["./dist/*"]
}
