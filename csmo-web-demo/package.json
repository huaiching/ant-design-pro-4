{
  "name": "@mli-csmo/cms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm-run-all --parallel start:*",
    "build": "cd cicd_build && yarn && cd ../ && lerna run build --sort",
    "start:container": "cd packages/app-container && yarn start",
    "start:demo": "cd packages/app-demo && yarn start",
    "gen:api": "node ./generate.js",
    "clean:node-modules": "rimraf ./node_modules",
    "clean-all": "lerna run 'clean:all' && lerna clean",
    "lint": "lerna run --ignore @mli-csmo/app-common --ignore @mli-csmo/app-model lint",
    "lint-staged": "lerna run --ignore /app-common --ignore @mli-csmo/app-model --concurrency 1 --stream lint-staged --since HEAD --exclude-dependents",
    "lint-staged:js": "node --max_old_space_size=8192 ./node_modules/eslint/bin/eslint.js --ext  \"*.{js,jsx,ts,tsx} packages/**/{src,config,mock,tests}/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "lerna run --ignore @mli-csmo/app-common --ignore @mli-csmo/app-model lint:fix",
    "lint:prettier": "lerna run --ignore @mli-csmo/app-common --ignore @mli-csmo/app-model lint:prettier",
    "prepare": "husky",
    "postinstall": "patch-package"
  },

  "resolutions": {
    "@ant-design/icons": "5.5.2",
    "@ant-design/pro-components": "2.7.19",
    "@types/react": "18.0.33",
    "@types/react-dom": "18.0.11",
    "react-router-dom": "6.3.0",
    "yargs": "17.7.2"
  },
  "dependencies": {
    "@ant-design/icons": "^4.8.3",
    "@ant-design/pro-components": "^2.7.19",
    "@babel/runtime": "7.18.0",
    "@babel/runtime-corejs3": "7.18.0",
    "antd": "^5.21.2",
    "antd-style": "^3.7.0",
    "dayjs": "^1.11.13",
    "keycloak-js": "21.1.1",
    "lodash": "^4.17.0",
    "mobx": "^6.13.5",
    "react-quill": "^2.0.0",
    "xlsx": "^0.18.5",
    "mobx-react": "^9.2.0",
    "number-precision": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "taiwan-id-validator": "^1.5.0",
    "@react-pdf/renderer": "^3.1.12"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.3.0",
    "@babel/cli": "7.17.10",
    "@babel/core": "7.17.12",
    "@babel/plugin-proposal-class-properties": "7.17.12",
    "@babel/plugin-proposal-decorators": "7.17.12",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.17.12",
    "@babel/plugin-proposal-optional-chaining": "7.17.12",
    "@babel/plugin-proposal-private-methods": "7.17.12",
    "@babel/plugin-proposal-private-property-in-object": "7.17.12",
    "@babel/plugin-transform-runtime": "7.17.12",
    "@babel/preset-env": "7.17.12",
    "@babel/preset-react": "7.17.12",
    "@babel/preset-typescript": "7.17.12",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/classnames": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/history": "^5.0.0",
    "@types/lodash": "^4.17.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/react-helmet": "^6.1.11",
    "@umijs/lint": "4.4.4",
    "@umijs/max": "4.4.4",
    "@umijs/plugins": "4.4.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "gh-pages": "^6.1.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lerna": "^6.6.2",
    "yargs": "^17.7.2",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "patch-package": "^6.4.7",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.2.1",
    "stylelint": "^13.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "umi-presets-pro": "2.0.3",
    "umi-serve": "1.9.11"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  }
}
