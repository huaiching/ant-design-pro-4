{
  "name": "@mli-csmo/openapi",
  "version": "1.11.0",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/es/index.d.ts",
      "require": "./dist/lib/index.js"
    }
  },
  "main": "dist/lib/index.js",
  "source": "src/index.ts",
  "typings": "dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "father build",
    "check-types": "tsc --noemit",
    "npmPublish": "npm publish",
    "prepare": "npm run build",
    "release-major": "npm run build && npm run check-types && release major",
    "release-minor": "npm run build && npm run check-types && release minor",
    "release-patch": "npm run build && npm run check-types && release patch",
    "watch": "father build --watch"
  },
  "devDependencies": {
    "glob": "^7.1.6",
    "memoizee": "^0.4.15",
    "node-fetch": "^2.6.1",
    "nunjucks": "3.2.2",
    "prettier": "^2.2.1",
    "openapi3-ts": "^2.0.1",
    "reserved-words": "^0.1.2",
    "rimraf": "^3.0.2",
    "swagger2openapi": "^7.0.4",
    "tiny-pinyin": "^1.3.2"
  },
  "engines": {
    "node": ">=14"
  }
}
